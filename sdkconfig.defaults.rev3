# Overlay for ESP32-P4 rev v3.x boards, applied AFTER sdkconfig.defaults.
# Support for <3.0 and >=3.0 is mutually exclusive: an image from the base
# defaults (max rev v1.99) does not boot on v3.x, and this one does not boot on
# v1.x. Build into its own directory and sdkconfig:
#   .\build.ps1 -C ../elotto_slave -B build_rev3 -D SDKCONFIG=sdkconfig.rev3 -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.rev3" build
# ⚠ OTA a node only with the image of its own revision (`chip_rev` per node).
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP32P4_REV_MIN_FULL=301
CONFIG_ESP_REV_MIN_FULL=301
CONFIG_ESP32P4_REV_MAX_FULL=399
CONFIG_ESP_REV_MAX_FULL=399
