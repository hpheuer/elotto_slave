# The boards are ESP32-P4 rev v1.3. ESP32P4_REV_MIN_0 *depends on*
# ESP32P4_SELECTS_REV_LESS_V3, which defaults to n — without the line below the
# choice silently falls back to ESP32P4_REV_MIN_301 (rev v3.1) and the resulting
# binary refuses to boot on rev 1.x hardware. Support for <3.0 and >=3.0 is
# mutually exclusive, so this must come first.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP32P4_REV_MIN_FULL=0
CONFIG_ESP_REV_MIN_FULL=0
CONFIG_ESP32P4_REV_MAX_FULL=199
CONFIG_ESP_REV_MAX_FULL=199

# --- Flash and partitions (docs/PLAN_NETWORK.md Phase A/C) ------------------
# Must match the master and the updater exactly: the SAME partitions.csv, or a
# board flashed by one project cannot be updated by another. The repos are
# siblings on disk, hence the ../elotto path.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../elotto/partitions.csv"

# Rollback defaults to n. With it on, an image that cannot answer over the
# network is reverted on the next boot — which is why this firmware must bring
# up Ethernet and a webserver before it marks itself valid (Phase C).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- OV5647 camera entropy --------------------------------------------------
# PSRAM is mandatory: the capture buffers (4 x 640 KB) and the extraction ring
# cannot fit in internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Sensor driver. The MODE is load-bearing and must match the master's: every
# gate was measured at RAW8 800x800 @ 50 fps.
# ⚠ The exposure is not fixed here -- this node sweeps its own ladder every
# block and keeps the rung it certifies, which is not the master's.
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X800_50FPS=y

# Shared elotto_camera component. Pins match the master (Espressif's
# Function-EV-Board reference for the 15-pin MIPI-CSI FPC connector); XCLK stays
# unwired because RPi-style OV5647 modules clock themselves.
CONFIG_ELOTTO_CAM_ENABLE=y
CONFIG_ELOTTO_CAM_SCL_PIN=8
CONFIG_ELOTTO_CAM_SDA_PIN=7
CONFIG_ELOTTO_CAM_XCLK_PIN=-1
CONFIG_ELOTTO_CAM_RESET_PIN=-1
CONFIG_ELOTTO_CAM_PWDN_PIN=-1
CONFIG_ELOTTO_CAM_XOR_FOLD=y
CONFIG_ELOTTO_CAM_REG_EXPOSURE=16
CONFIG_ELOTTO_CAM_REG_GAIN=1023

# No DVP camera on these boards — MIPI-CSI only; keeping it off avoids linking a
# device we never open. Matches the master.
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n

# --- HTTP server (Phase C: the slave is now OTA-updatable like every node) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- Compiler ---------------------------------------------------------------
# -O2, not the IDF default -Og. Worth ~14 % on its own when measured in
# isolation on 2026-08-18 (3,42 -> 3,81 Mbit/s idle, 52,6 -> 47,3 cycles per
# pixel), and the binary got SMALLER with it.
#
# ⚠ Those figures are a SNAPSHOT of the byte-at-a-time extractor and no longer
# describe this firmware: the word-wise extractor landed the same day and the
# idle rate is 5,71 Mbit/s now. The bottlenecks the note used to blame -- a
# per-pixel `volatile s_xor_fold` load, a non-inlined process_word -- are gone;
# the fold flag is read once per frame. Do not quote 3,8 as a current number,
# and re-measure before crediting -O2 with anything on today's code.
# Source quality is unaffected by the flag, as it must be.
# Assertions stay ENABLED: they are a correctness net, not a speed knob.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
